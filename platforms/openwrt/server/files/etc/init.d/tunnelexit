#!/bin/sh /etc/rc.common

# 配置统一放在 /etc/config/tunnelexit，运行参数以环境变量下发给 run.sh

START=95
STOP=10
USE_PROCD=1

# 启动隧道服务端，按 UCI 配置下发端口参数
start_service() {
	config_load tunnelexit

	local enabled
	config_get_bool enabled server enabled 1
	if [ "$enabled" -eq 0 ]; then
		logger -t tunnelexit "已在 /etc/config/tunnelexit 中禁用，跳过启动"
		return 0
	fi

	local port socks_host socks_port_base socks_port_count pool_size
	local web_host web_port web_path
	config_get port server port 9733
	config_get socks_host server socks_host '0.0.0.0'
	config_get socks_port_base server socks_port_base 19733
	config_get socks_port_count server socks_port_count 2500
	config_get pool_size server pool_size 16
	config_get web_host server web_host '127.0.0.1'
	config_get web_port server web_port 9732
	config_get web_path server web_path '/'

	procd_open_instance tunnelexit
	procd_set_param command /usr/share/tunnelexit/run.sh
	procd_set_param env TUNNELEXIT_PORT="$port"
	procd_set_param env TUNNELEXIT_SOCKS_HOST="$socks_host"
	procd_set_param env TUNNELEXIT_SOCKS_PORT_BASE="$socks_port_base"
	procd_set_param env TUNNELEXIT_SOCKS_PORT_COUNT="$socks_port_count"
	procd_set_param env TUNNELEXIT_POOL_SIZE="$pool_size"
	procd_set_param env TUNNELEXIT_WEB_HOST="$web_host"
	procd_set_param env TUNNELEXIT_WEB_PORT="$web_port"
	procd_set_param env TUNNELEXIT_WEB_PATH="$web_path"
	# 异常退出后自动重启
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# stop 服务后自动重新读取 UCI 配置
reload_service() {
	stop
	start
}

# /etc/config/tunnelexit 变化时触发 reload
service_triggers() {
	procd_add_reload_trigger tunnelexit
}
