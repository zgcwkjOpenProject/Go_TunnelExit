#!/bin/sh /etc/rc.common

# 客户端配置只以 client.json 为准，不引入 UCI，避免出现第二份配置来源

START=96
STOP=10
USE_PROCD=1

# 启动隧道客户端，运行参数全部来自 client.json
start_service() {
	procd_open_instance tunnelexit-client
	procd_set_param command /usr/share/tunnelexit-client/run.sh
	# 异常退出后自动重启
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# stop 服务后重新启动，让客户端重新读取 client.json
reload_service() {
	stop
	start
}
